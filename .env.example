# Copy to .env.local and fill in. See AUTH_PLAN.md §6 for the full list.

# --- Client (must be VITE_-prefixed; shipped to the browser) ---
# From the Neon Console: Auth page → Configuration tab, and Data API page → API tab.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# Force-open the Pro-gated tabs (Optimize/Evolve) without signing in.
# Set to 1 on Vercel PREVIEW deploys only — never in Production.
# VITE_DISABLE_PRO_GATE=1

# --- Server only (Vercel function env; Stripe + DB). NEVER prefix with VITE_. ---
# DATABASE_URL=            # Neon Postgres connection string (direct/owner)
# STRIPE_SECRET_KEY=       # Stripe secret key
# STRIPE_WEBHOOK_SECRET=   # from the Stripe webhook endpoint
# STRIPE_PRICE_ID=         # the one-time "lifetime Pro" Price
# NEON_AUTH_JWKS_URL=      # JWKS endpoint for verifying session JWTs (confirm in Neon Console)
# APP_URL=                 # optional success/cancel base URL; falls back to the request Origin
